{
  "name": "johnnyxlemonade/profiler",
  "description": "Local development request, SQL and rendering profiler for Lemonade Framework.",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.3 <8.6",
    "johnnyxlemonade/framework": "dev-main",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.3",
    "friendsofphp/php-cs-fixer": "^3.94"
  },
  "autoload": {
    "psr-4": {
      "Lemonade\\Profiler\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lemonade\\Profiler\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --memory-limit=1G",
    "cs:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff --allow-risky=yes --config=.php-cs-fixer.php",
    "cs:fix": "@php vendor/bin/php-cs-fixer fix --allow-risky=yes --config=.php-cs-fixer.php",
    "qa": [
      "@test",
      "@stan",
      "@cs:check"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}
